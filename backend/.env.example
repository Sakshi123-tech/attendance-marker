# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/smart_attendance

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
COOKIE_SECRET=your_cookie_secret_key_here

# Client Origin (CORS)
CLIENT_URL=http://localhost:3000

# Nodemailer / Email Service configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password_or_app_password

# Cloudinary Credentials (if using for face images / files)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Default Super Admin Bootstrap Credentials
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=superadmin@attendance.com
SUPER_ADMIN_PASSWORD=AdminSecurePass123!
SUPER_ADMIN_EMP_ID=EMP-0000
